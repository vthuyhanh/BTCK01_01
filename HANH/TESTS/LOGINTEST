package Test;

import io.github.bonigarcia.wdm.WebDriverManager;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.testng.Assert;
import org.testng.annotations.AfterMethod;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;
import Pages.DashboardPage;
import Pages.LoginPage;

import java.time.Duration;

import static java.lang.Thread.sleep;

public class LoginTest {

    private WebDriver driver;
    private LoginPage loginPage;

    @BeforeMethod
    public void setUp() {
        WebDriverManager.chromedriver().setup();
        driver = new ChromeDriver();

        driver.manage().window().maximize();
        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(40));

        driver.get("https://olms.codedao.io.vn");

        loginPage = new LoginPage(driver);  // ✅ Tạo một lần ở đây
    }

    @Test
    public void testValidLogin() throws InterruptedException {
        loginPage.loginAs("testadmin", "test1234");


        DashboardPage dashboardPage = new DashboardPage(driver);
        Assert.assertTrue(dashboardPage.isUserLoggedIn(), "❌ Đăng nhập thất bại hoặc trang dashboard chưa load.");
    }

    @Test
    public void testInvalidLogin() {
        loginPage.loginAs("invalidUser", "wrongPassword");

        String errorMessage = loginPage.getLoginErrorMessage();
        Assert.assertTrue(errorMessage != null && !errorMessage.isEmpty(), "❌ Không hiển thị thông báo lỗi như mong đợi.");
    }

    @AfterMethod
    public void tearDown() {
        if (driver != null) {
            driver.quit();
        }
    }
}

