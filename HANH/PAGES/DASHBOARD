package Pages;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;

import java.util.Objects;

public class DashboardPage extends BasePage {


    private final By title = By.xpath("(//h2)[1]");
    private final By menuTrangChu = By.xpath("(//span)[4]");
    private final String url = "/dashboard";

    public DashboardPage(WebDriver driver) {
        super(driver); // driver đã được truyền vào và gán từ BasePage
    }

    // Kiểm tra URL hiện tại có chứa "/dashboard" không
    public boolean verifyUrl() {
        System.out.println(driver.getCurrentUrl());
        System.out.println(url);
        return Objects.requireNonNull(driver.getCurrentUrl()).contains(url);
    }

    // Kiểm tra xem người dùng đã đăng nhập chưa (qua icon avatar)
    public boolean isUserLoggedIn() {
        return isVisible(menuTrangChu);
    }

    // Getter và Setter nếu cần
    public By getTitle() {
        return title;
    }

}



